# RECOMAI Environment Configuration
PROJECT_NAME="RECOMAI"
PROJECT_TAGLINE="Discover what fits you, powered by intelligence."
ENVIRONMENT="development"
DEBUG=True

# API Configuration
API_V1_PREFIX="/api/v1"
SECRET_KEY="recomai-super-secure-production-secret-key-cse-portfolio"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
# Primary: PostgreSQL with psycopg driver
DATABASE_URL="postgresql+psycopg://postgres:231223@localhost:5432/recomai"
# Fallback local sqlite for development verification if PostgreSQL server is offline
FALLBACK_SQLITE_URL="sqlite+pysqlite:///./recomai_local.db"

# MAX & Mojo Settings
MAX_EMBEDDING_DIM=64
MAX_MODEL_NAME="modular-max-semantic-base"
MOJO_ENABLED=True
MOJO_BIN_PATH="mojo"
